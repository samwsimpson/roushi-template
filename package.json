{
  "name": "roushi",
  "version": "0.13.3",
  "private": false,
  "description": "Self-wiring knowledge layer + autonomous coordination plane for portfolio operators",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:extensions": "tsx scripts/run-sql.ts drizzle/0000_setup_extensions.sql",
    "db:indexes": "tsx scripts/run-sql.ts drizzle/post-migration-indexes.sql",
    "db:setup": "pnpm db:extensions && pnpm db:push && pnpm db:indexes",
    "test": "vitest run",
    "test:watch": "vitest",
    "roushi": "tsx --env-file=.env.local src/cli/index.ts",
    "mcp": "tsx --env-file=.env.local src/mcp/server.ts",
    "mcp:http": "tsx --env-file=.env.local src/mcp/http-server.ts",
    "sync-template": "tsx scripts/sync-template.ts",
    "hooks:install": "tsx scripts/install-git-hooks.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "latest",
    "@auth/drizzle-adapter": "latest",
    "@modelcontextprotocol/sdk": "latest",
    "@neondatabase/serverless": "latest",
    "@next/third-parties": "^16.2.6",
    "@tailwindcss/postcss": "latest",
    "@types/cross-spawn": "^6.0.6",
    "@vercel/analytics": "^2.0.1",
    "ai": "latest",
    "chalk": "latest",
    "class-variance-authority": "latest",
    "clsx": "latest",
    "commander": "latest",
    "cross-spawn": "^7.0.6",
    "cytoscape": "^3.33.4",
    "date-fns": "latest",
    "drizzle-orm": "latest",
    "gray-matter": "latest",
    "lucide-react": "latest",
    "nanoid": "latest",
    "next": "latest",
    "next-auth": "5.0.0-beta.25",
    "postgres": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-markdown": "^10.1.0",
    "remark": "latest",
    "remark-parse": "latest",
    "resend": "^6.12.4",
    "tailwind-merge": "latest",
    "tailwindcss": "latest",
    "unified": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@biomejs/biome": "latest",
    "@types/cytoscape": "^3.31.0",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vercel/config": "^0.5.0",
    "dotenv": "latest",
    "drizzle-kit": "latest",
    "google-auth-library": "^10.6.2",
    "tsx": "latest",
    "typescript": "latest",
    "vitest": "latest"
  }
}
