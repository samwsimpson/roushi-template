# ─── Database ───────────────────────────────────────────────
# Neon Postgres connection string (with pgvector extension enabled).
# If deploying via the "Deploy to Vercel" button, this is auto-provisioned
# by the Neon Marketplace integration — you don't need to set it manually.
# For local dev: https://console.neon.tech → your project → Connection Details
DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/roushi?sslmode=require"

# ─── AI providers ───────────────────────────────────────────
# OpenAI for embeddings (text-embedding-3-small). Required.
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=""

# Vercel AI Gateway — single endpoint for all LLM calls (optional).
# If blank, the `think` command won't work until you set either this
# or ANTHROPIC_API_KEY below. https://vercel.com/docs/ai-gateway
AI_GATEWAY_API_KEY=""

# Direct Anthropic for fallback or local dev without gateway (optional).
ANTHROPIC_API_KEY=""

# ─── Auth.js v5 ─────────────────────────────────────────────
# Required for signed sessions. Generate one:
#   bash:  openssl rand -base64 32
#   pwsh:  [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }))
AUTH_SECRET=""

# Auth.js URL — local dev uses http://localhost:3000. In production,
# Vercel sets VERCEL_URL automatically; Auth.js uses it as fallback.
AUTH_URL="http://localhost:3000"

# GitHub OAuth — create at: https://github.com/settings/developers → New OAuth App
#   Homepage URL:                ${AUTH_URL}  (or your production domain)
#   Authorization callback URL:  ${AUTH_URL}/api/auth/callback/github
# Until both are set, auth is DISABLED and the UI is open (no sign-in required).
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Comma-separated email allow-list (case-insensitive). Empty = anyone with a
# GitHub account can sign in. Set this in production.
# Example: "you@example.com,teammate@example.com"
AUTH_ALLOWED_EMAILS=""

# ─── Roushi config ─────────────────────────────────────────
# Bearer token for the MCP HTTP endpoint (/api/mcp). Required for API access.
# Generate one:
#   bash:  openssl rand -hex 32
#   pwsh:  -join ((1..32) | ForEach-Object { '{0:x2}' -f (Get-Random -Maximum 256) })
ROUSHI_MCP_HTTP_TOKEN=""

# Cron jobs auth. Vercel adds Authorization: Bearer ${CRON_SECRET}
# to cron invocations automatically. Set to any random string.
CRON_SECRET=""

# ─── Email (optional) ─────────────────────────────────────
# Resend for form notification emails. Without this, the beta
# request form logs to Vercel function logs instead of emailing.
# Get from: https://resend.com/api-keys
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Roushi <noreply@your-domain.com>"

# ─── Google Analytics (pattern automation, optional) ──────
# Service account JSON for the GA Admin API. Used by the
# `pnpm roushi pattern apply google-analytics` automation
# to auto-create GA4 properties for new projects.
#
# Setup: create a GCP service account, grant it Editor on your
# GA account, then either:
#   - Local dev: set GOOGLE_APPLICATION_CREDENTIALS to the path
#     of the JSON key file (gitignored)
#   - Production (Vercel): paste the entire JSON content into
#     GOOGLE_SERVICE_ACCOUNT_JSON as a single env var
GOOGLE_APPLICATION_CREDENTIALS=""
GOOGLE_SERVICE_ACCOUNT_JSON=""
GOOGLE_GA_ACCOUNT_ID=""

# ─── Advanced (rarely need to change) ─────────────────────
ROUSHI_CONTENT_DIR="./content"
ROUSHI_MCP_HTTP_PORT="3737"
ROUSHI_EMBEDDING_MODEL="text-embedding-3-small"
ROUSHI_EMBEDDING_DIMENSIONS="1536"
ROUSHI_REASONING_MODEL="anthropic/claude-opus-4-7"
ROUSHI_EXTRACTION_MODEL="anthropic/claude-haiku-4-5"
ROUSHI_MCP_ALLOWED_ORIGINS="http://localhost:*"
